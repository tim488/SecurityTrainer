@inherits ProgressAwareComponent

<div class="quiz">
    <h3>@L("Which change fixes it?", "Welche Änderung schließt die Lücke?")</h3>
    @foreach (var option in _options)
    {
        <label class="option @OptionClass(option)">
            <input type="radio" name="fix-@Mission.Slug" value="@option.Id"
                   checked="@(_selected == option.Id)" disabled="@Solved"
                   @onchange="() => _selected = option.Id" />
            <StoryPanel Speaker="Lt. Barclay" Text="@L(option.BarclayLine)" Kind="barclay" />
            <CodeBlock Code="@option.CodeFor(Progress.Settings.CodeStyle)" Language="@option.Language" />
            @if (Solved || _wrong.Contains(option.Id))
            {
                <p class="feedback">@(option.IsCorrect ? "✔ " : "✘ ")@L(option.Feedback)</p>
            }
        </label>
    }

    @if (!Solved)
    {
        <button class="primary" disabled="@(_selected is null)" @onclick="Submit">@L("Check answer", "Antwort prüfen")</button>
        <span class="muted">@L("Attempts", "Versuche"): @Progress.Get(Mission.Slug).Attempts</span>
    }
    else
    {
        <div class="explanation">
            <h3>@L("Explanation", "Erklärung")</h3>
            <MarkdownView Text="@L(Mission.ExplanationMarkdown)" />
        </div>
        <StoryPanel Speaker="@L("Debrief", "Nachbesprechung")" Text="@L(Mission.Story.Debrief)" Kind="debrief" />
        <div class="mission-done">
            <p class="success">@L("Mission completed.", "Mission abgeschlossen.")</p>
            <div class="mission-done-actions">
                @if (NextMission is { } next && !ReferenceEquals(next, Mission))
                {
                    <a class="button primary" href="@($"missions/{next.Slug}")">@L("Next mission", "Nächste Mission"): @next.Story.Act.@next.Story.Order @L(next.Title)</a>
                }
                <a class="button" href="/">@L("Back to the missions", "Zurück zu den Missionen")</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IMission Mission { get; set; } = default!;

    private List<FixOption> _options = [];
    private readonly HashSet<string> _wrong = [];
    private string? _selected;

    private bool Solved => Progress.Get(Mission.Slug).FixAnsweredCorrectly;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _options = Mission.FixOptions.ToList();
        Random.Shared.Shuffle(System.Runtime.InteropServices.CollectionsMarshal.AsSpan(_options));
    }

    private string OptionClass(FixOption option) =>
        Solved ? (option.IsCorrect ? "correct" : "wrong")
        : _wrong.Contains(option.Id) ? "wrong"
        : _selected == option.Id ? "selected" : "";

    private async Task Submit()
    {
        var option = _options.FirstOrDefault(o => o.Id == _selected);
        if (option is null) return;

        if (!option.IsCorrect) _wrong.Add(option.Id);
        await Progress.UpdateAsync(Mission.Slug, p =>
        {
            p.Attempts++;
            if (option.IsCorrect) p.FixAnsweredCorrectly = true;
        });
    }
}
