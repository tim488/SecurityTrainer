@inherits ProgressAwareComponent
@inject FlagService Flags

<div class="flag-input">
    <h3>@L("Submit the flag", "Flag einreichen")</h3>
    @if (Progress.Get(Slug).FlagSubmitted)
    {
        <p class="success">@L("Flag accepted.", "Flag akzeptiert.")</p>
        <StoryPanel Speaker="@L("A calling card from Lore", "Lores Visitenkarte")" Text="@CallingCard" Kind="calling-card" />
        <button class="primary" @onclick="OnAccepted">@L("Continue to fix", "Weiter zum Absichern") &rarr;</button>
    }
    else
    {
        <form @onsubmit="Submit" @onsubmit:preventDefault>
            <input @bind="_value" placeholder="FLAG{...}" aria-label="Flag" autocomplete="off" spellcheck="false" />
            <button type="submit" class="primary">@L("Submit", "Einreichen")</button>
        </form>
        @if (_wrong)
        {
            <p class="error">@L("That is not the flag for this lab.", "Das ist nicht die Flag für dieses Lab.")</p>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter] public string? CallingCard { get; set; }
    [Parameter] public EventCallback OnAccepted { get; set; }

    private string _value = "";
    private bool _wrong;

    private async Task Submit()
    {
        _wrong = !Flags.Check(Slug, _value);
        if (_wrong) return;

        await Progress.UpdateAsync(Slug, p => p.FlagSubmitted = true);
        _value = "";
    }
}
