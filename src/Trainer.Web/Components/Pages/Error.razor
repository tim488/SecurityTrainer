@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

@* Rendered without interactivity, so the saved language setting isn't available: the browser's language decides. *@
<PageTitle>@L("Error", "Fehler")</PageTitle>

<h1>@L("Something went wrong", "Etwas ist schiefgegangen")</h1>
<p>@L("The trainer ran into an unexpected error. Go back to the missions and try again. If it keeps happening, restart the app.",
      "Im Trainer ist ein unerwarteter Fehler aufgetreten. Geh zurück zu den Missionen und versuch es noch einmal. Wenn das öfter passiert, starte die App neu.")</p>
<div class="actions"><a class="button" href="/">@L("Back to the missions", "Zurück zu den Missionen")</a></div>

@if (!string.IsNullOrEmpty(RequestId))
{
    <p class="muted">@L("Request ID", "Request-ID"): <code>@RequestId</code></p>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private Language _language;

    private string L(string en, string de) => _language == Language.De ? de : en;

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        _language = HttpContext is null ? Language.En : Languages.FromRequest(HttpContext.Request);
    }
}
