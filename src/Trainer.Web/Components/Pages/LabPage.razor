@page "/labs/{Slug}"
@inherits ProgressAwareComponent
@inject RequestSender Sender

@if (_lab is null)
{
    <PageTitle>@L("Lab not found", "Lab nicht gefunden")</PageTitle>
    <h1>@L("Lab not found", "Lab nicht gefunden")</h1>
    <p>@L("There is no lab called", "Es gibt kein Lab namens") <code>@Slug</code>. <a href="/">@L("Back to the case board", "Zurück zur Einsatzübersicht")</a>.</p>
    return;
}

<PageTitle>@L(_lab.Title)</PageTitle>

<p><a href="/">&larr; @L("Case board", "Einsatzübersicht")</a></p>
<h1>@L(_lab.Title)</h1>
<p class="card-meta">
    <span class="tag">@_lab.Category</span>
    <span class="tag difficulty-@_lab.Difficulty.ToString().ToLowerInvariant()">@L(_lab.Difficulty)</span>
    <span class="tag status">@L(Progress.StatusOf(_lab.Slug))</span>
    <button class="link-button" @onclick="ResetLab">@L("Reset lab", "Lab zurücksetzen")</button>
</p>

<nav class="steps">
    <button class="@StepClass(Step.Read)" @onclick="() => _step = Step.Read">1. @L("Read", "Lesen")</button>
    <button class="@StepClass(Step.Exploit)" @onclick="() => _step = Step.Exploit">2. @L("Exploit", "Angreifen")</button>
    <button class="@StepClass(Step.Fix)" disabled="@(!LabProgress.FlagSubmitted)"
            title="@(LabProgress.FlagSubmitted ? null : L("Submit the flag first", "Reiche zuerst die Flag ein"))"
            @onclick="() => _step = Step.Fix">3. @L("Fix", "Absichern")</button>
</nav>

@switch (_step)
{
    case Step.Read:
        <section>
            <StoryPanel Speaker="@L("Captain's log", "Logbuch des Captains")" Text="@L(_lab.Story.Briefing)" Kind="briefing" />
            <MarkdownView Text="@L(_lab.ScenarioMarkdown)" />
            <HintList Slug="@_lab.Slug" Hints="_lab.Hints" />
            <button class="primary" @onclick="() => _step = Step.Exploit">@L("Continue to exploit", "Weiter zum Angriff") &rarr;</button>
        </section>
        break;

    case Step.Exploit:
        <section>
            <RequestConsole @key="_resetCount" Slug="@_lab.Slug" DefaultRequest="_lab.DefaultRequest" />
            <FlagInput Slug="@_lab.Slug" CallingCard="@L(_lab.Story.CallingCard)" OnAccepted="() => _step = Step.Fix" />
        </section>
        break;

    case Step.Fix:
        <section>
            <FixQuiz @key="_resetCount" Lab="_lab" />
        </section>
        break;
}

@code {
    private enum Step { Read, Exploit, Fix }

    [Parameter] public string Slug { get; set; } = "";

    private ILab? _lab;
    private Step _step = Step.Read;
    private int _resetCount;

    private LabProgress LabProgress => Progress.Get(_lab!.Slug);

    protected override void OnParametersSet()
    {
        var lab = Registry.Find(Slug);
        if (!ReferenceEquals(lab, _lab)) _step = Step.Read;
        _lab = lab;
    }

    private string StepClass(Step step) => step == _step ? "step active" : "step";

    private async Task ResetLab()
    {
        _lab!.Reset();
        Sender.ClearHistory(_lab.Slug);
        await Progress.ClearAsync(_lab.Slug);
        _resetCount++;
        _step = Step.Read;
    }
}
