@page "/labs/{Slug}"
@inherits ProgressAwareComponent
@inject RequestSender Sender

@if (_lab is null)
{
    <PageTitle>@L("Mission not found", "Mission nicht gefunden")</PageTitle>
    <h1>@L("Mission not found", "Mission nicht gefunden")</h1>
    <p>@L("There is no mission called", "Es gibt keine Mission namens") <code>@Slug</code>. <a href="/">@L("Back to the missions", "Zurück zu den Missionen")</a>.</p>
    return;
}

@if (IsLocked(_lab))
{
    @* Progress is read from the browser after the first render: until then, don't claim the mission is locked. *@
    if (!Progress.IsLoaded)
    {
        <PageTitle>Security Trainer</PageTitle>
        return;
    }
    <PageTitle>@L("Mission locked", "Mission gesperrt")</PageTitle>
    var next = NextMission!;
    var number = $"{next.Story.Act}.{next.Story.Order}";
    <h1>@L("Mission locked", "Mission gesperrt")</h1>
    <p>@L("Story mode is on, so missions open one after another. Complete this mission first:",
          "Im Story-Modus werden die Missionen nacheinander freigeschaltet. Schließ zuerst diese Mission ab:")
       <a href="@($"labs/{next.Slug}")">@number @L(next.Title)</a></p>
    <p><button @onclick="() => Progress.SetStoryModeAsync(false)">@L("Switch to free play", "Zum freien Spiel wechseln")</button></p>
    return;
}

<PageTitle>@L(_lab.Title)</PageTitle>

<header class="lab-header">
    <h1>@L(_lab.Title)</h1>
    @* Plain labels, not controls: no box, no fill. *@
    <p class="lab-facts">
        <span>@_lab.Category</span>
        <span class="difficulty-@_lab.Difficulty.ToString().ToLowerInvariant()">@L(_lab.Difficulty)</span>
    </p>
</header>

@* Tabs on the left, lab facts on the right, all on the bar that leads into the section. *@
<div class="steps-row">
<nav class="steps" role="tablist">
    <button role="tab" aria-selected="@(_step == Step.Exploit ? "true" : "false")" class="@StepClass(Step.Exploit)"
            @onclick="() => _step = Step.Exploit">
        <span class="step-no">01</span><span class="step-label">@L("Exploit", "Angreifen")</span>
    </button>
    <button role="tab" aria-selected="@(_step == Step.Fix ? "true" : "false")" class="@StepClass(Step.Fix)"
            disabled="@(!LabProgress.FlagSubmitted)"
            title="@(LabProgress.FlagSubmitted ? null : L("Submit the flag first", "Reiche zuerst die Flag ein"))"
            @onclick="() => _step = Step.Fix">
        <span class="step-no">02</span><span class="step-label">@L("Fix", "Absichern")</span>
    </button>
</nav>
<div class="lab-actions">
    @* Only how endpoint code is shown; the lab's API stays the same. *@
    @if (CodeStyles.HasVariants(_lab))
    {
        <div class="pill-switch" role="group" aria-label="@L("Endpoint code style", "Stil des Endpunkt-Codes")">
            @foreach (var (style, label) in Styles)
            {
                <button type="button" class="@(Progress.Settings.CodeStyle == style ? "active" : null)"
                        aria-pressed="@(Progress.Settings.CodeStyle == style ? "true" : "false")"
                        @onclick="() => Progress.SetCodeStyleAsync(style)">@label</button>
            }
        </div>
    }
    <button class="reset-lab" @onclick="ResetLab">@L("Reset mission", "Mission zurücksetzen")</button>
</div>
</div>

@switch (_step)
{
    case Step.Exploit:
        <section>
            @* The briefing folds up once the flag is in, to keep the page short. *@
            <StoryPanel Speaker="@L("Captain's log", "Logbuch des Captains")" Text="@L(_lab.Story.Briefing)" Kind="briefing"
                        Collapsed="LabProgress.FlagSubmitted" />
            <MarkdownView Text="@L(_lab.ScenarioMarkdown)" />
            <HintList Slug="@_lab.Slug" Hints="_lab.Hints" />
            @if (_lab is IHasModeratorView moderator && _lab.Tools.Contains(LabTool.ModeratorView))
            {
                <ModeratorView @key="_resetCount" Src="@moderator.ModeratorViewUrl" />
            }
            @if (_lab.Tools.Contains(LabTool.Repeater))
            {
                <Repeater @key="_resetCount" Slug="@_lab.Slug" DefaultRequest="_lab.DefaultRequest" />
            }
            <RequestConsole @key="_resetCount" @ref="_console" Slug="@_lab.Slug" DefaultRequest="_lab.DefaultRequest" />
            @if (_lab.Tools.Contains(LabTool.JwtEditor))
            {
                <JwtEditor @key="_resetCount" InitialToken="@BearerToken(_lab.DefaultRequest)" OnUse="UseToken" />
            }
            <FlagInput Slug="@_lab.Slug" CallingCard="@L(_lab.Story.CallingCard)" OnAccepted="() => _step = Step.Fix" />
        </section>
        break;

    case Step.Fix:
        <section>
            <FixQuiz @key="_resetCount" Lab="_lab" />
        </section>
        break;
}

@code {
    private enum Step { Exploit, Fix }

    private static readonly (CodeStyle, string)[] Styles = [(CodeStyle.MinimalApi, "Minimal API"), (CodeStyle.Controller, "Controller")];

    [Parameter] public string Slug { get; set; } = "";

    private ILab? _lab;
    private Step _step = Step.Exploit;
    private int _resetCount;
    private RequestConsole? _console;

    private LabProgress LabProgress => Progress.Get(_lab!.Slug);

    protected override void OnParametersSet()
    {
        var lab = Registry.Find(Slug);
        if (!ReferenceEquals(lab, _lab)) _step = Step.Exploit;
        _lab = lab;
    }

    private static string BearerToken(RequestTemplate request) =>
        request.Headers.TryGetValue("Authorization", out var value) && value.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
            ? value["Bearer ".Length..]
            : "";

    private void UseToken(string token) => _console?.SetHeader("Authorization", $"Bearer {token}");

    private string StepClass(Step step) => step == _step ? "step active" : "step";

    private async Task ResetLab()
    {
        _lab!.Reset();
        Sender.ClearHistory(_lab.Slug);
        await Progress.ClearAsync(_lab.Slug);
        _resetCount++;
        _step = Step.Exploit;
    }
}
