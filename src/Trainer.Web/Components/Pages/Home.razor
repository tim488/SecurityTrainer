@page "/"
@using Trainer.Web.Core.Story
@inherits ProgressAwareComponent
@inject RequestSender Sender

<PageTitle>Security Trainer</PageTitle>

<h1>@L("Missions", "Missionen")</h1>

<div class="board-bar">
    <p class="muted">@L($"{Completed} of {Registry.Missions.Count} missions completed", $"{Completed} von {Registry.Missions.Count} Missionen abgeschlossen")</p>
    <div class="pill-switch" role="group" aria-label="@L("Mission order", "Reihenfolge der Missionen")">
        <button type="button" class="@(StoryMode ? "active" : null)" aria-pressed="@(StoryMode ? "true" : "false")"
                title="@L("Missions open one after another", "Missionen werden nacheinander freigeschaltet")"
                @onclick="() => Progress.SetStoryModeAsync(true)">@L("Story mode", "Story-Modus")</button>
        <button type="button" class="@(StoryMode ? null : "active")" aria-pressed="@(StoryMode ? "false" : "true")"
                title="@L("Every mission is open", "Alle Missionen sind offen")"
                @onclick="() => Progress.SetStoryModeAsync(false)">@L("Free play", "Freies Spiel")</button>
    </div>
</div>


@* Every scene reached so far stays on the page. Only the newest one is open; the others are folded up. *@
<StoryPanel Speaker="@L("Prologue", "Prolog")" Text="@L(Acts.OpeningScene)" Kind="epilogue"
            Foldable="true" Collapsed="@(NewestScene != OpeningKey)" />

@foreach (var group in Registry.Missions.GroupBy(m => m.Story.Act).OrderBy(g => g.Key))
{
    var act = Acts.Find(group.Key);
    var done = group.Count(m => Progress.Get(m.Slug).IsCompleted);
    <section class="act">
        <h2>@L("Act", "Akt") @group.Key@(act is null ? "" : $": {L(act.Title)}") <span class="act-count">@done/@group.Count()</span></h2>
        <div class="cards">
            @foreach (var mission in group.OrderBy(m => m.Story.Order))
            {
                var status = Progress.StatusOf(mission.Slug);
                var number = Number(mission);
                if (IsLocked(mission))
                {
                    @* The title stays hidden until the mission opens: Lore's calling card names it first. *@
                    <div class="card locked" aria-disabled="true">
                        <span class="card-order"><svg class="card-mark card-icon card-lock" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="7" width="10" height="8" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>@number</span>
                        <span class="card-body">
                            <span class="card-title">@L("Locked", "Gesperrt")</span>
                            <span class="mission-facts">
                                <span>@L($"Complete {Number(NextMission!)} first", $"Erst {Number(NextMission!)} abschließen")</span>
                            </span>
                        </span>
                    </div>
                    continue;
                }
                var next = ReferenceEquals(mission, NextMission);
                var cardClass = $"card status-{status.ToString().ToLowerInvariant()}" + (next ? " next" : "");
                @* Number block on the left (its colour is the status), title and plain labels on the right. *@
                <a class="@cardClass" href="@($"missions/{mission.Slug}")">
                    <span class="card-order">
                        @if (status == MissionStatus.Solved)
                        {
                            <svg class="card-mark card-icon card-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8" /></svg>
                        }
                        @number
                    </span>
                    <span class="card-body">
                        <span class="card-title">@L(mission.Title)</span>
                        <span class="mission-facts">
                            <span>@mission.Category</span>
                            <span class="difficulty-@mission.Difficulty.ToString().ToLowerInvariant()">@L(mission.Difficulty)</span>
                            @if (status != MissionStatus.New)
                            {
                                <span class="status-@status.ToString().ToLowerInvariant()">@L(status)</span>
                            }
                            @if (next)
                            {
                                <span class="status-next">@L("next", "als Nächstes")</span>
                            }
                        </span>
                    </span>
                </a>
            }
        </div>
        @if (act is not null && done == group.Count())
        {
            <StoryPanel Speaker="@L($"End of act {act.Number}", $"Ende des {act.Number}. Akts")" Text="@L(act.Ending)" Kind="epilogue"
                        Foldable="true" Collapsed="@(NewestScene != ActKey(act))" />
        }
    </section>
}

@if (Registry.Missions.Count > 0 && Completed == Registry.Missions.Count)
{
    <StoryPanel Speaker="Finale" Text="@L(Acts.Finale)" Kind="epilogue"
                Foldable="true" Collapsed="@(NewestScene != FinaleKey)" />
}

@if (_confirmReset)
{
    @* Asks first: a reset can't be undone. *@
    <div class="reset-confirm" role="alertdialog" aria-labelledby="reset-question">
        <p id="reset-question">@L("Reset all missions? Your progress is deleted from this browser and every mission starts fresh. Language and story mode stay as they are.",
                                   "Alle Missionen zurücksetzen? Dein Fortschritt wird aus diesem Browser gelöscht und jede Mission beginnt von vorn. Sprache und Story-Modus bleiben, wie sie sind.")</p>
        <div class="actions">
            <button type="button" class="small danger" @onclick="ResetAll">@L("Reset everything", "Alles zurücksetzen")</button>
            <button type="button" class="small" @onclick="() => _confirmReset = false">@L("Cancel", "Abbrechen")</button>
        </div>
    </div>
}
else
{
    <div class="actions board-footer">
        <button type="button" class="small" @onclick="() => _confirmReset = true">@L("Reset all progress", "Fortschritt zurücksetzen")</button>
    </div>
}

@code {
    private int Completed => Registry.Missions.Count(m => Progress.Get(m.Slug).IsCompleted);

    private bool StoryMode => Progress.Settings.StoryMode;

    private bool _confirmReset;

    /// <summary>Starts the whole game over: browser progress, each mission's server state and the request history.</summary>
    private async Task ResetAll()
    {
        foreach (var mission in Registry.Missions)
        {
            mission.Reset();
            Sender.ClearHistory(mission.Slug);
        }
        await Progress.ClearAllAsync(Registry.Missions.Select(m => m.Slug));
        _confirmReset = false;
    }

    private const string OpeningKey = "opening", FinaleKey = "finale";
    private static string ActKey(Act act) => $"act-{act.Number}";

    /// <summary>The scene the player reached last: the finale, else the latest finished act's ending, else the opening.</summary>
    private string NewestScene
    {
        get
        {
            if (Acts.Finale is not null && Registry.Missions.Count > 0 && Completed == Registry.Missions.Count)
                return FinaleKey;
            var finished = Registry.Missions.GroupBy(m => m.Story.Act)
                .Where(g => g.All(m => Progress.Get(m.Slug).IsCompleted))
                .Select(g => Acts.Find(g.Key))
                .Where(a => a?.Ending is not null)
                .MaxBy(a => a!.Number);
            return finished is null ? OpeningKey : ActKey(finished);
        }
    }

    private static string Number(IMission mission) => $"{mission.Story.Act}.{mission.Story.Order}";
}
