@page "/"
@using Trainer.Web.Core.Story
@inherits ProgressAwareComponent

<PageTitle>Security Trainer</PageTitle>

<h1>@L("Missions", "Missionen")</h1>

<p class="muted">@L($"{Completed} of {Registry.Labs.Count} missions completed", $"{Completed} von {Registry.Labs.Count} Missionen abgeschlossen")</p>

@if (Completed == 0)
{
    <StoryPanel Text="@L(Acts.OpeningScene)" Kind="epilogue" />
}

@foreach (var group in Registry.Labs.GroupBy(l => l.Story.Act).OrderBy(g => g.Key))
{
    var act = Acts.Find(group.Key);
    <section class="act">
        <h2>@L("Act", "Akt") @group.Key@(act is null ? "" : $": {L(act.Title)}")</h2>
        @if (act is not null)
        {
            <p class="muted">@L(act.Tagline)</p>
        }
        <div class="cards">
            @foreach (var lab in group.OrderBy(l => l.Story.Order))
            {
                var status = Progress.StatusOf(lab.Slug);
                @* Number block on the left (its colour is the status), title and plain labels on the right. *@
                <a class="card status-@status.ToString().ToLowerInvariant()" href="@($"labs/{lab.Slug}")">
                    <span class="card-order">@lab.Story.Act.@lab.Story.Order</span>
                    <span class="card-body">
                        <span class="card-title">@L(lab.Title)</span>
                        <span class="lab-facts">
                            <span>@lab.Category</span>
                            <span class="difficulty-@lab.Difficulty.ToString().ToLowerInvariant()">@L(lab.Difficulty)</span>
                            @if (status != LabStatus.New)
                            {
                                <span class="status-@status.ToString().ToLowerInvariant()">@L(status)</span>
                            }
                        </span>
                    </span>
                </a>
            }
        </div>
        @if (act is not null && group.All(l => Progress.Get(l.Slug).IsCompleted))
        {
            <StoryPanel Text="@L(act.Ending)" Kind="epilogue" />
        }
    </section>
}

@if (Registry.Labs.Count > 0 && Completed == Registry.Labs.Count)
{
    <StoryPanel Text="@L(Acts.Finale)" Kind="epilogue" />
}

@code {
    private int Completed => Registry.Labs.Count(l => Progress.Get(l.Slug).IsCompleted);
}
