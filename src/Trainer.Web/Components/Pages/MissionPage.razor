@page "/missions/{Slug}"
@inherits ProgressAwareComponent
@inject RequestSender Sender

@if (_mission is null)
{
    <PageTitle>@L("Mission not found", "Mission nicht gefunden")</PageTitle>
    <h1>@L("Mission not found", "Mission nicht gefunden")</h1>
    <p>@L("There is no mission called", "Es gibt keine Mission namens") <code>@Slug</code>. <a href="/">@L("Back to the missions", "Zurück zu den Missionen")</a>.</p>
    return;
}

@if (IsLocked(_mission))
{
    @* Progress is read from the browser after the first render: until then, don't claim the mission is locked. *@
    if (!Progress.IsLoaded)
    {
        <PageTitle>Security Trainer</PageTitle>
        return;
    }
    <PageTitle>@L("Mission locked", "Mission gesperrt")</PageTitle>
    var next = NextMission!;
    var number = $"{next.Story.Act}.{next.Story.Order}";
    <h1>@L("Mission locked", "Mission gesperrt")</h1>
    <p>@L("Story mode is on, so missions open one after another. Complete this mission first:",
          "Im Story-Modus werden die Missionen nacheinander freigeschaltet. Schließ zuerst diese Mission ab:")
       <a href="@($"missions/{next.Slug}")">@number @L(next.Title)</a></p>
    <p><button @onclick="() => Progress.SetStoryModeAsync(false)">@L("Switch to free play", "Zum freien Spiel wechseln")</button></p>
    return;
}

<PageTitle>@L(_mission.Title)</PageTitle>

<header class="mission-header">
    <h1>@L(_mission.Title)</h1>
    @* Plain labels, not controls: no box, no fill. *@
    <p class="mission-facts">
        <span>@_mission.Category</span>
        <span class="difficulty-@_mission.Difficulty.ToString().ToLowerInvariant()">@L(_mission.Difficulty)</span>
    </p>
</header>

@* Tabs on the left, mission facts on the right, all on the bar that leads into the section. *@
<div class="steps-row">
<nav class="steps" role="tablist">
    <button role="tab" aria-selected="@(_step == Step.Exploit ? "true" : "false")" class="@StepClass(Step.Exploit)"
            @onclick="() => _step = Step.Exploit">
        <span class="step-no">01</span><span class="step-label">@L("Exploit", "Angreifen")</span>
    </button>
    <button role="tab" aria-selected="@(_step == Step.Fix ? "true" : "false")" class="@StepClass(Step.Fix)"
            disabled="@(!MissionProgress.FlagSubmitted)"
            title="@(MissionProgress.FlagSubmitted ? null : L("Submit the flag first", "Reiche zuerst die Flag ein"))"
            @onclick="() => _step = Step.Fix">
        <span class="step-no">02</span><span class="step-label">@L("Fix", "Absichern")</span>
    </button>
</nav>
<div class="mission-actions">
    @* Only how endpoint code is shown; the mission's API stays the same. *@
    @if (CodeStyles.HasVariants(_mission))
    {
        <div class="pill-switch" role="group" aria-label="@L("Endpoint code style", "Stil des Endpunkt-Codes")">
            @foreach (var (style, label) in Styles)
            {
                <button type="button" class="@(Progress.Settings.CodeStyle == style ? "active" : null)"
                        aria-pressed="@(Progress.Settings.CodeStyle == style ? "true" : "false")"
                        @onclick="() => Progress.SetCodeStyleAsync(style)">@label</button>
            }
        </div>
    }
    <button class="reset-mission" @onclick="ResetMission">@L("Reset mission", "Mission zurücksetzen")</button>
</div>
</div>

@switch (_step)
{
    case Step.Exploit:
        @* One key for the whole step: Reset bumps it, and everything inside starts fresh.
           Keys on the tools themselves would be siblings with the same value, which Blazor rejects. *@
        <section @key="_resetCount">
            @* The briefing folds up once the flag is in, to keep the page short. *@
            <StoryPanel Speaker="@L("Captain's log", "Logbuch des Captains")" Text="@L(_mission.Story.Briefing)" Kind="briefing"
                        Collapsed="MissionProgress.FlagSubmitted" />
            <MarkdownView Text="@L(_mission.ScenarioMarkdown)" />
            <HintList Slug="@_mission.Slug" Hints="_mission.Hints" />
            @if (_mission is IHasModeratorView moderator && _mission.Tools.Contains(MissionTool.ModeratorView))
            {
                <ModeratorView Src="@moderator.ModeratorViewUrl" />
            }
            @if (_mission.Tools.Contains(MissionTool.Repeater))
            {
                <Repeater Slug="@_mission.Slug" DefaultRequest="_mission.DefaultRequest" />
            }
            <RequestConsole @ref="_console" Slug="@_mission.Slug" DefaultRequest="_mission.DefaultRequest" />
            @if (_mission.Tools.Contains(MissionTool.JwtEditor))
            {
                <JwtEditor InitialToken="@BearerToken(_mission.DefaultRequest)" OnUse="UseToken" />
            }
            <FlagInput Slug="@_mission.Slug" CallingCard="@L(_mission.Story.CallingCard)" OnAccepted="() => _step = Step.Fix" />
        </section>
        break;

    case Step.Fix:
        <section @key="_resetCount">
            <FixQuiz Mission="_mission" />
        </section>
        break;
}

@code {
    private enum Step { Exploit, Fix }

    private static readonly (CodeStyle, string)[] Styles = [(CodeStyle.MinimalApi, "Minimal API"), (CodeStyle.Controller, "Controller")];

    [Parameter] public string Slug { get; set; } = "";

    private IMission? _mission;
    private Step _step = Step.Exploit;
    private int _resetCount;
    private RequestConsole? _console;

    private MissionProgress MissionProgress => Progress.Get(_mission!.Slug);

    protected override void OnParametersSet()
    {
        var mission = Registry.Find(Slug);
        if (!ReferenceEquals(mission, _mission)) _step = Step.Exploit;
        _mission = mission;
    }

    private static string BearerToken(RequestTemplate request) =>
        request.Headers.TryGetValue("Authorization", out var value) && value.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase)
            ? value["Bearer ".Length..]
            : "";

    private void UseToken(string token) => _console?.SetHeader("Authorization", $"Bearer {token}");

    private string StepClass(Step step) => step == _step ? "step active" : "step";

    private async Task ResetMission()
    {
        _mission!.Reset();
        Sender.ClearHistory(_mission.Slug);
        await Progress.ClearAsync(_mission.Slug);
        _resetCount++;
        _step = Step.Exploit;
    }
}
