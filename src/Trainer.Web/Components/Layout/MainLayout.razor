@inherits LayoutComponentBase
@implements IDisposable
@inject ProgressStore Progress
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Ship's computer frame: elbow top left, bar across the top, blocks down the left side. *@
<div class="frame">
    <div class="frame-elbow" aria-hidden="true"></div>

    <header class="frame-top">
        <div class="frame-bar">
            <span class="bar bar-orange"></span>
            <span class="bar bar-lilac"></span>
            <a href="/" class="brand">Security Trainer</a>
            @* The language switch closes the bar on the right. *@
            <div class="lang-switch" role="group" aria-label="@L("Language", "Sprache")">
                @foreach (var (language, label) in Languages)
                {
                    <button type="button" class="@(Lang == language ? "active" : null)"
                            aria-pressed="@(Lang == language ? "true" : "false")"
                            @onclick="() => Progress.SetLanguageAsync(language)">@label</button>
                }
            </div>
        </div>
    </header>

    <nav class="frame-side" aria-label="@L("Main", "Hauptnavigation")">
        <a href="/" class="side-block side-orange"><span class="side-label">@L("Missions", "Missionen")</span></a>
        <div class="side-block side-peach" aria-hidden="true"></div>
        <div class="side-block side-lilac side-tall"><span class="side-label">@L("Stardate", "Sternzeit")</span><span class="side-label stardate">@Trainer.Web.Core.Story.Stardate.Format(DateTime.Now)</span></div>
        @* Decoration: the ship and its registry number. *@
        <div class="side-block side-sky side-fill" aria-hidden="true"><span class="side-label">USS Enterprise</span><span class="side-no">NCC-1701-D</span></div>
    </nav>

    <main class="content" @ref="_content">
        @Body
    </main>
</div>

@* Shown by Blazor when a component throws and the page stops responding. *@
<div id="blazor-error-ui" data-nosnippet>
    @L("Something went wrong, and this page stopped responding.", "Etwas ist schiefgegangen, und die Seite reagiert nicht mehr.")
    <a href="." class="reload button small primary">@L("Reload", "Neu laden")</a>
    <span class="dismiss" role="button" aria-label="@L("Close", "Schließen")">✕</span>
</div>

@code {
    private static readonly (Language, string)[] Languages = [(Language.En, "EN"), (Language.De, "DE")];

    private Language Lang => Progress.Settings.Language;

    private string L(string en, string de) => Lang == Language.De ? de : en;

    private ElementReference _content;
    private string _path = "";
    private bool _scrollToTop;

    protected override void OnInitialized()
    {
        _path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('#', '?')[0];
        Progress.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // Only a new page starts at the top; a changed query or #fragment keeps its place.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = Navigation.ToBaseRelativePath(e.Location).Split('#', '?')[0];
        if (path == _path) return;
        _path = path;
        _scrollToTop = true;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollToTop) return;
        _scrollToTop = false;
        try { await JS.InvokeVoidAsync("trainerLayout.scrollTop", _content); }
        catch (JSDisconnectedException) { }
    }

    public void Dispose()
    {
        Progress.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
