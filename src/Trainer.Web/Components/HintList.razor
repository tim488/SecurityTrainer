@inherits ProgressAwareComponent

@if (Hints.Count > 0)
{
    <div class="hints">
        <h3>@L("Hints", "Hinweise")</h3>
        @if (!SkipStory)
        {
            <p class="story-speaker">Lt. Commander Data</p>
        }
        <ol>
            @foreach (var hint in Hints.Take(Revealed))
            {
                <li><MarkdownView Text="@L(hint)" /></li>
            }
        </ol>
        @if (Revealed < Hints.Count)
        {
            <button @onclick="RevealNext">@L($"Reveal hint {Revealed + 1} of {Hints.Count}", $"Hinweis {Revealed + 1} von {Hints.Count} anzeigen")</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<Text> Hints { get; set; } = [];

    private int Revealed => Math.Min(Progress.Get(Slug).HintsRevealed, Hints.Count);

    private Task RevealNext() => Progress.UpdateAsync(Slug, p => p.HintsRevealed = Math.Min(p.HintsRevealed + 1, Hints.Count));
}
